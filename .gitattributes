# 默认自动检测文本文件并规范化换行符
* text=auto

# Linux Shell 脚本强制使用 LF
*.sh text eol=lf

# Python 脚本使用 LF
*.py text eol=lf

# Dockerfile 使用 LF
Dockerfile text eol=lf

# Windows 批处理文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不进行换行符转换
*.so binary
*.zip binary
*.tar.gz binary

# C/C++ 源代码
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf