# =====================================================
# 默认规则：自动识别文本文件，规范化为 LF
# =====================================================
* text=auto

# =====================================================
# Linux / 跨平台文本文件：工作区也强制使用 LF
# =====================================================
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.gdb text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.crt text eol=lf

# PEM 私钥为文本格式时使用 LF
# 如果仓库中存在 DER 等二进制 .key 文件，应单独设置 binary
*.key text eol=lf

# =====================================================
# Windows 批处理文件：工作区使用 CRLF
# =====================================================
*.bat text eol=crlf
*.cmd text eol=crlf

# =====================================================
# 二进制文件：禁止文本换行符转换
# =====================================================
*.so binary
*.bin binary
*.exe binary
*.dll binary
*.zip binary
*.tar binary
*.gz binary
*.tar.gz binary
*.7z binary